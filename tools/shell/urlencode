#!/bin/bash

# Read input (argument or interactive prompt)
input="${1:-}"
[ -z "$input" ] && read -p "Enter characters to URL encode: " input

# URL encoding function (reusable for single/double encoding)
url_encode() {
  printf "%s" "$1" | xxd -plain | tr -d '\n' | sed 's/\(..\)/%\1/g'
}

single_encoded=$(url_encode "$input")
double_encoded=$(url_encode "$single_encoded")

echo "Original: $input"
echo "Single encoded: $single_encoded"
echo "Double encoded: $double_encoded"